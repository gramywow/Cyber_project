# Formulaire de contact : sans la clé et la boîte de réception, le site indique que le formulaire n'est pas relié.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Facultatif tant qu'aucun domaine n'est vérifié chez Resend : l'envoi part alors de l'expéditeur
# de test de Resend, qui ne délivre qu'à l'adresse du compte Resend (à mettre dans CONTACT_TO_EMAIL).
# CONTACT_FROM_EMAIL="Use Case Factory <contact@votre-domaine.fr>"
